[ext_resource type="Script" path="res://content/dados_raca.gd" id="1_raca"]
[resource]
script = ExtResource("1_raca")
id = "raca_khemri"
nome = "Khemri Cinzenta"
origem = "Necrópole afundada de Khemri (Egito esotérico). Sacerdotes que trocaram a mumificação pela Fenda."
principio_hermetico = "Polaridade: toda perda vira escudo, toda sombra vira luz."
passiva_nome = "Véu Polar"
passiva_desc = "20% do dano recebido vira escudo temporal de 3s. Acumula até 30% da vida máx."
passiva_valores = {"conversao": 0.2, "duracao": 3.0, "cap_pct_vida": 0.3}
ativa_nome = "Detonação Polar"
ativa_desc = "Inverte o escudo atual em dano em área. Escudo maior = explosão maior + breve invulnerabilidade."
ativa_cooldown = 22.0
ativa_raio = 6.5
vfx_direcao = "Anel duplo preto/dourado, brasas subindo, sem cobrir projéteis inimigos. Camada 2."
mutacao_visual = "Faixas funerárias emissivas douradas nos braços + olhos brancos."
